{
  "expo": {
    "name": "ChickyPen",
    "slug": "chickypen",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "chickypen",
    "userInterfaceStyle": "light",
    "platforms": ["ios"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chickypen.app",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "vi",
        "CFBundleLocalizations": ["vi"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      "expo-font",
      "expo-status-bar",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
